{
  "name": "ring-webhook-mailbox",
  "version": "0.1.0",
  "description": "A public HTTPS mailbox for Ring partner webhooks that a home hub behind NAT pulls with signed requests (AWS Lambda function URL + DynamoDB).",
  "type": "module",
  "exports": {
    ".": "./src/mailbox.mjs",
    "./client": "./client/mailbox-client.mjs",
    "./store": "./src/store.mjs",
    "./handler": "./src/handler.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs dist"
  },
  "files": [
    "src",
    "client",
    "scripts",
    "examples",
    "template.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiarong0423/ring-webhook-mailbox.git"
  }
}
